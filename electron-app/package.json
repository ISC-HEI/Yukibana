{
  "private": true,
  "name": "yukibana-electron-app",
  "description": "Yukibana IDE",
  "version": "0.0.0",
  "main": "scripts/theia-electron-main.js",
  "author": "Yukibana Team <info.yukibana@isc-vs.ch>",
  "homepage": "https://github.com/ISC-HEI/Yukibana#readme",
  "bugs": {
    "url": "https://github.com/ISC-HEI/Yukibana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISC-HEI/Yukibana.git"
  },
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/electron": "1.75.0",
    "@theia/file-search": "^1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/plugin-ext": "^1.75.0",
    "@theia/plugin-ext-vscode": "^1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/search-in-workspace": "^1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/workspace": "1.75.0",
    "yukibana": "0.0.0"
  },
  "devDependencies": {
    "@theia/bundle-plugin": "^1.75.0",
    "@theia/cli": "1.75.0",
    "@wdio/cli": "^6.12.1",
    "@wdio/local-runner": "^6.12.1",
    "@wdio/mocha-framework": "^6.11.0",
    "@wdio/spec-reporter": "^6.11.0",
    "electron": "42.8.1",
    "electron-builder": "^26.15.3",
    "electron-chromedriver": "^43.7.0",
    "electron-mocha": "^13.1.0",
    "electron-osx-sign": "^0.6.0",
    "rimraf": "^4.4.1",
    "wdio-chromedriver-service": "^6.0.4",
    "webdriverio": "^6.12.1"
  },
  "scripts": {
    "clean": "theia clean && rimraf node_modules",
    "clean:dist": "rimraf dist",
    "bundle": "npm run rebuild && theia build --mode development",
    "build": "yarn -s rebuild && theia build --app-target=\"electron\" --mode development",
    "build:prod": "yarn -s rebuild && theia build --app-target=\"electron\"",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start --log-level=debug --plugins=local-dir:../plugins",
    "watch": "npm run rebuild && theia build --watch --mode development",
    "prepackage": "node scripts/patch-ripgrep-asar-path.mjs",
    "package": "yarn clean:dist && yarn rebuild && electron-builder -c.mac.identity=null --publish never",
    "package:prod": "yarn deploy",
    "deploy": "yarn clean:dist && yarn rebuild && electron-builder -c.mac.identity=null --publish always",
    "test": "mocha --timeout 60000 \"./tests/*.spec.js\"",
    "lint": "eslint --ext js,jsx,ts,tsx scripts && eslint --ext js,jsx,ts,tsx test",
    "lint:fix": "eslint --ext js,jsx,ts,tsx scripts --fix && eslint --ext js,jsx,ts,tsx test -fix"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Yukibana",
        "reloadOnReconnect": true,
        "electron": {
          "appUserModelId": "isc.yukibana",
          "splashScreenOptions": {
            "content": "resources/YukibanaSplash.svg",
            "height": 256,
            "width": 256,
            "minDuration": 2000
          }
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".yukibana"
      }
    }
  },
  "theiaPluginsDir": "../plugins"
}
