{
  "private": true,
  "name": "yukibana-electron-app",
  "description": "Yukibana IDE",
  "version": "0.1.0",
  "main": "scripts/theia-electron-main.js",
  "author": "Yukibana Team <info.yukibana@isc-vs.ch>",
  "homepage": "https://github.com/ISC-HEI/Yukibana#readme",
  "bugs": {
    "url": "https://github.com/ISC-HEI/Yukibana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISC-HEI/Yukibana.git"
  },
  "dependencies": {
    "@theia/ai-anthropic": "~1.76.0",
    "@theia/ai-chat": "~1.76.0",
    "@theia/ai-chat-ui": "~1.76.0",
    "@theia/ai-core": "~1.76.0",
    "@theia/ai-ide": "~1.76.0",
    "@theia/core": "~1.76.0",
    "@theia/debug": "~1.76.0",
    "@theia/editor": "~1.76.0",
    "@theia/electron": "~1.76.0",
    "@theia/file-search": "~1.76.0",
    "@theia/filesystem": "~1.76.0",
    "@theia/markers": "~1.76.0",
    "@theia/messages": "~1.76.0",
    "@theia/monaco": "~1.76.0",
    "@theia/navigator": "~1.76.0",
    "@theia/outline-view": "~1.76.0",
    "@theia/plugin-ext": "~1.76.0",
    "@theia/plugin-ext-vscode": "~1.76.0",
    "@theia/preferences": "~1.76.0",
    "@theia/process": "~1.76.0",
    "@theia/scm": "~1.76.0",
    "@theia/search-in-workspace": "~1.76.0",
    "@theia/telemetry": "~1.76.0",
    "@theia/terminal": "~1.76.0",
    "@theia/test": "~1.76.0",
    "@theia/toolbar": "~1.76.0",
    "@theia/workspace": "~1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yukibana-cloud-ext": "workspace:*",
    "yukibana-ext": "workspace:*",
    "yukibana-launcher-ext": "workspace:*",
    "yukibana-product-ext": "workspace:*",
    "yukibana-submission-ext": "workspace:*",
    "yukibana-telemetry-ext": "workspace:*"
  },
  "devDependencies": {
    "@theia/bundle-plugin": "~1.76.0",
    "@theia/cli": "~1.76.0",
    "electron": "42.8.1",
    "electron-builder": "^26.18.0"
  },
  "scripts": {
    "clean": "theia clean",
    "watch": "theia build --watch --mode development"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Yukibana",
        "reloadOnReconnect": true,
        "defaultTheme": "Default Dark Modern",
        "defaultIconTheme": "theia-file-icons",
        "electron": {
          "appUserModelId": "isc.yukibana",
          "uriScheme": "yukibana",
          "splashScreenOptions": {
            "content": "resources/YukibanaSplash.svg",
            "height": 256,
            "width": 256,
            "minDuration": 2000
          }
        },
        "preferences": {
          "security.workspace.trust.enabled": false,
          "telemetry.telemetryLevel": "all",
          "debug.internalConsoleOptions": "neverOpen",
          "debug.openDebug": "neverOpen",
          "metals.disableReleaseNotes": true,
          "workbench.startupEditor": "none"
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".yukibana"
      }
    }
  },
  "theiaPluginsDir": "../plugins",
  "desktopName": "yukibana"
}
