{
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "node scripts/cli.mts build",
    "start": "node scripts/cli.mts start",
    "package": "node scripts/cli.mts package",
    "download:plugins": "node scripts/cli.mts download:plugins",
    "clean": "node scripts/cli.mts clean",
    "postinstall": "theia check:theia-version",
    "lint": "eslint --ext js,jsx,ts,tsx,mts scripts packages theia-extensions tests && pnpm run -r --if-present lint",
    "lint:fix": "eslint --ext js,jsx,ts,tsx,mts scripts packages theia-extensions tests --fix && pnpm run -r --if-present lint:fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter yukibana-tests exec playwright test",
    "config:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-config-schema.mts"
  },
  "devDependencies": {
    "@eclipse-dash/nodejs-wrapper": "^0.0.1",
    "@theia/cli": "~1.75.0",
    "@types/node": "26.6.3",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/eslint-plugin-tslint": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "@vitest/coverage-v8": "5.0.3",
    "chai": "6.3.0",
    "eslint": "^7.32.0",
    "eslint-plugin-deprecation": "1.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-no-unsanitized": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "ignore-styles": "5.0.1",
    "jsdom": "30.1.2",
    "tslint": "^5.20.1",
    "vitest": "5.0.3",
    "yargs": "^17.7.3"
  },
  "theiaPlugins": {
    "vscode-builtin-extensions": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode-builtin-extensions-1.108.2.tar.gz",
    "vscjava.vscode-java-pack": "https://open-vsx.org/api/vscjava/vscode-java-pack/0.30.5/file/vscjava.vscode-java-pack-0.30.5.vsix",
    "vscjava.vscode-java-dependency": "https://open-vsx.org/api/vscjava/vscode-java-dependency/0.27.0/file/vscjava.vscode-java-dependency-0.27.0.vsix",
    "scalameta.metals": "https://open-vsx.org/api/scalameta/metals/1.70.0/file/scalameta.metals-1.70.0.vsix",
    "ms-ceintl.vscode-language-pack-fr": "https://open-vsx.org/api/MS-CEINTL/vscode-language-pack-fr/1.131.0/file/MS-CEINTL.vscode-language-pack-fr-1.131.0.vsix"
  },
  "theiaPluginsExcludeIds": [
    "ms-vscode.js-debug-companion",
    "vscode.extension-editing",
    "vscode.microsoft-authentication"
  ],
  "workspaces": [
    "packages/*",
    "theia-extensions/*",
    "browser-app",
    "electron-app",
    "tests"
  ]
}
