{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:browser": "yarn build:extensions && npm --prefix browser-app run bundle",
    "build:electron": "yarn build:extensions && npm --prefix electron-app run bundle",
    "build": "yarn build:extensions && yarn build:applications",
    "build:dev": "yarn build:extensions && yarn build:applications:dev",
    "build:applications": "lerna run --scope=\"yukibana*app\" --ignore=\"yukibana-next*\" build:prod --concurrency 1",
    "build:applications:dev": "lerna run --scope=\"yukibana*app\" --ignore=\"yukibana-next*\" build --concurrency 1",
    "build:extensions": "lerna run --scope=\"*-ext\" build",
    "package:applications": "lerna run --scope=\"yukibana*app\" --ignore=\"yukibana-next*\" package --concurrency 1",
    "package:applications:preview": "lerna run --scope=\"yukibana*app\" --ignore=\"yukibana-next*\" package:preview --concurrency 1",
    "package:applications:prod": "lerna run --scope=\"yukibana*app\" --ignore=\"yukibana-next*\" package:prod --concurrency 1",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start:browser": "npm --prefix browser-app start",
    "start:electron": "npm --prefix electron-app start",
    "watch:browser": "lerna run --parallel watch --ignore electron-app",
    "watch:electron": "lerna run --parallel watch --ignore browser-app",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false && yarn permissions:writeable",
    "permissions:writeable": "ts-node scripts/make-files-writeable.ts plugins",
    "lint": "eslint --ext js,jsx,ts,tsx scripts && lerna run lint",
    "lint:fix": "eslint --ext js,jsx,ts,tsx scripts --fix && lerna run lint:fix",
    "test": "lerna run test",
    "electron": "yarn --cwd electron-app",
    "browser": "yarn --cwd browser-app"
  },
  "devDependencies": {
    "@eclipse-dash/nodejs-wrapper": "^0.0.1",
    "@theia/cli": "1.75.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/eslint-plugin-tslint": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "eslint": "^7.32.0",
    "eslint-plugin-deprecation": "1.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-no-unsanitized": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "lerna": "^8.2.4",
    "ts-node": "^10.9.2",
    "tslint": "^5.20.1",
    "yargs": "^17.7.3"
  },
  "theiaPlugins": {
    "vscode-builtin-extensions": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode-builtin-extensions-1.108.2.tar.gz",
    "vscjava.vscode-java-pack": "https://open-vsx.org/api/vscjava/vscode-java-pack/0.30.5/file/vscjava.vscode-java-pack-0.30.5.vsix",
    "vscjava.vscode-java-dependency": "https://open-vsx.org/api/vscjava/vscode-java-dependency/0.27.0/file/vscjava.vscode-java-dependency-0.27.0.vsix",
    "scalameta.metals": "https://open-vsx.org/api/scalameta/metals/1.70.0/file/scalameta.metals-1.70.0.vsix"
  },
  "theiaPluginsExcludeIds": [
    "ms-vscode.js-debug-companion",
    "vscode.extension-editing",
    "vscode.microsoft-authentication"
  ],
  "workspaces": [
    "theia-extensions/*",
    "browser-app",
    "electron-app"
  ]
}
