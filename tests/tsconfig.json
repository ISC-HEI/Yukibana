{
  "extends": "../configs/base.tsconfig.json",
  "compilerOptions": {
    // Playwright compiles the tests itself.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ]
  },
  "include": [
    "*.ts",
    "src/**/*",
    "e2e/**/*"
  ]
}
