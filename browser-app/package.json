{
  "private": true,
  "name": "yukibana-browser-app",
  "version": "0.1.0",
  "dependencies": {
    "@theia/ai-anthropic": "~1.75.0",
    "@theia/ai-chat": "~1.75.0",
    "@theia/ai-chat-ui": "~1.75.0",
    "@theia/ai-core": "~1.75.0",
    "@theia/ai-ide": "~1.75.0",
    "@theia/core": "~1.75.0",
    "@theia/debug": "~1.75.0",
    "@theia/editor": "~1.75.0",
    "@theia/filesystem": "~1.75.0",
    "@theia/markers": "~1.75.0",
    "@theia/messages": "~1.75.0",
    "@theia/monaco": "~1.75.0",
    "@theia/navigator": "~1.75.0",
    "@theia/outline-view": "~1.75.0",
    "@theia/plugin-ext": "~1.75.0",
    "@theia/plugin-ext-vscode": "~1.75.0",
    "@theia/preferences": "~1.75.0",
    "@theia/process": "~1.75.0",
    "@theia/scm": "~1.75.0",
    "@theia/terminal": "~1.75.0",
    "@theia/test": "~1.75.0",
    "@theia/toolbar": "~1.75.0",
    "@theia/workspace": "~1.75.0",
    "yukibana-cloud-ext": "workspace:*",
    "yukibana-ext": "workspace:*",
    "yukibana-submission-ext": "workspace:*",
    "yukibana-telemetry-ext": "workspace:*"
  },
  "devDependencies": {
    "@theia/cli": "~1.75.0"
  },
  "scripts": {
    "clean": "theia clean",
    "watch": "theia build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Yukibana",
        "reloadOnReconnect": true,
        "defaultTheme": "Default Dark Modern",
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "security.workspace.trust.enabled": false,
          "telemetry.telemetryLevel": "all",
          "debug.internalConsoleOptions": "neverOpen",
          "debug.openDebug": "neverOpen",
          "metals.disableReleaseNotes": true
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".yukibana"
      }
    }
  },
  "theiaPluginsDir": "../plugins"
}
