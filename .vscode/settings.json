{
  "editor.formatOnSave": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/lib": true,
    "**/coverage": true
  },
  "json.schemas": [
    {
      "fileMatch": ["electron-app/package.json", "browser-app/package.json"],
      "url": "./theia-package-schema.json"
    }
  ],
  "[typescript]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "files.insertFinalNewline": true,
  "editor.rulers": [180],
  "js/ts.preferences.quoteStyle": "single",
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "js/ts.preferences.quoteStyle": "single",
    "editor.tabSize": 4
  },
  "oxc.enable": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  }
}
