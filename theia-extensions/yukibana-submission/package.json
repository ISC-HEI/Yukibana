    "src"
  ],
  "dependencies": {
    "@theia/core": "~1.75.0",
    "@theia/telemetry": "~1.75.0",
    "@theia/workspace": "~1.75.0",
    "yukibana-common": "workspace:*",
    "yukibana-ext": "workspace:*",
    "@yukibana/cli": "github:tothambrus11/yukibana-cloud#main&path:/cli"
  },
  "devDependencies": {
